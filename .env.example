# ==========================================
# CloudConnect Environment Configuration
# Copy this file to .env and adjust as needed.
# ==========================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="CloudConnect Implementation Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=generate-a-strong-random-secret-key-for-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration
# For local Docker Compose / PostgreSQL:
DATABASE_URL=postgresql+asyncpg://cloudconnect:cloudconnect_secret@localhost:5432/cloudconnect_db
# For zero-dependency local SQLite development/testing:
# DATABASE_URL=sqlite+aiosqlite:///./cloudconnect.db

# Provider Configuration
CONTACT_CENTER_PROVIDER=simulator
# Options: 'simulator' (default, local safe testing) | 'amazon_connect' (AWS integration)

# Amazon Connect (Optional - required ONLY if CONTACT_CENTER_PROVIDER=amazon_connect)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder-do-not-commit-real-keys
AWS_SECRET_ACCESS_KEY=placeholder-do-not-commit-real-keys
AWS_CONNECT_INSTANCE_ID=00000000-0000-0000-0000-000000000000
AWS_CONNECT_CONTACT_FLOW_ID=00000000-0000-0000-0000-000000000000
AWS_CONNECT_SOURCE_PHONE=+18005550199

# Logging
LOG_LEVEL=INFO
